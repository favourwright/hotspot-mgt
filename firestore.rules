rules_version = '2';

// Closed. Every read and write in this app goes through the Admin SDK, which
// bypasses these rules, so the client SDK has no business touching anything.
//
// Authorization lives in the API routes and server-component gates. This file
// used to allow a few reads, and each one had a cost: world-readable collections
// let anyone spend the project's shared daily read quota without signing in,
// which takes every page down. A permission here is also a second copy of
// authorization logic, and twice now a hole in it reached custom claims
// (docs/auth-and-security.md).
//
// Think hard before adding a rule back. If the browser needs something, write an
// API route with a named-field response. A rule that opens a collection returns
// whole documents, including whatever gets added to them later.
//
// Order matters when deploying this: the app build that stopped using the client
// SDK has to be live first. See docs/deploy-runbook.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
