rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Locations — public read, write by admin only (server-side)
    match /locations/{locationId} {
      allow read: if true; // public read for landing page
      allow write: if false; // server-side only
    }

    // Plans — public read, write by admin only (server-side)
    match /plans/{planId} {
      allow read: if true; // public read for landing page
      allow write: if false; // server-side only
    }

    // Vouchers — customers read their own, admins read all, authenticated users can read limited for social proof
    match /vouchers/{voucherId} {
      allow read: if request.auth != null && 
        (isAdmin() ||
         resource.data.userId == request.auth.uid || 
         (request.query.limit <= 3 && resource.data.status == "active"));
      allow write: if false; // server-side only
    }

    // Payments — customers read their own, admins read all
    match /payments/{paymentId} {
      allow read: if request.auth != null && 
        (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if false; // server-side only
    }
  }
}