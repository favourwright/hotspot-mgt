rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Helper Functions ───────────────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == "superadmin";
    }
    
    // Check tenant ownership directly from the 
    // tenant document's ownerUid field rather than 
    // going through the user document.
    // This avoids double Firestore reads in rules.
    function isTenantOwnerDirect(tenantId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid;
    }
    
    function isSuperAdminOrOwner(tenantId) {
      return isSuperAdmin() || isTenantOwnerDirect(tenantId);
    }
    
    // ─── Platform Collections ────────────────────────
    
    // Users - own document only, superadmin reads all
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
    
    // Tenants - owner and superadmin only, server-side for everything else.
    //
    // This document carries accountNumber, accountName, bankName and the
    // Paystack customer/subscription/subaccount codes, so a public read
    // handed all of that to anyone who could guess a tenant id. The only
    // client-side read in the app is resolveOwnerTenantSlug (lib/owner-
    // redirect.ts), which fetches `slug` for the signed-in owner, and that
    // still works here. Every other consumer is a server component or API
    // route using the Admin SDK, which bypasses rules entirely.
    //
    // Writes are closed outright rather than allowed for the owner. An
    // owner could otherwise set their own platformFeePercent to 0, flip
    // subscriptionStatus to "active", clear monthlyFee, or swap planId for
    // a richer tier, straight from the browser console - and once addon
    // entitlements exist, grant themselves every paid addon for free. There
    // is no legitimate caller: the app makes no client-side writes anywhere,
    // so this closes a capability nothing uses.
    match /tenants/{tenantId} {
      allow read: if isSuperAdminOrOwner(tenantId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
      
      // Locations - owner and superadmin only
      match /locations/{locationId} {
        allow read: if isSuperAdminOrOwner(tenantId);
        allow write: if false;
      }
      
      // Plans - public read so customers can browse
      match /plans/{planId} {
        allow read: if true;
        allow write: if false;
      }
      
      // Vouchers - owner sees all, customer sees own
      match /vouchers/{voucherId} {
        allow read: if isSuperAdminOrOwner(tenantId) || 
                       (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }
      
      // Payments - owner sees all, customer sees own
      match /payments/{paymentId} {
        allow read: if isSuperAdminOrOwner(tenantId) || 
                       (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }
      
      // Customers - owner sees all, customer sees own
      match /customers/{customerId} {
        allow read: if isSuperAdminOrOwner(tenantId) || isOwner(customerId);
        allow write: if false;
      }

      // Addon entitlements - closed in both directions, deliberately.
      //
      // This is the paywall. A tenant able to write here grants themselves
      // every paid addon; a tenant able to read here learns nothing useful
      // that /api/admin/addons does not already tell them, and the API can
      // apply the grace-window logic that a raw document read cannot. Only
      // the Admin SDK touches this: the activate route after verifying a
      // payment against Paystack, and the webhook for status changes.
      match /entitlements/{addonKey} {
        allow read: if false;
        allow write: if false;
      }
    }
    
    // ─── Legacy Flat Collections ─────────────────────
    //
    // Pre-multi-tenancy leftovers. Nothing writes to them, and as of the
    // removal of the orphaned hooks that queried them (use-vouchers,
    // use-all-vouchers, use-active-users, use-customer-plans) nothing in
    // the app reads them from the client either - every remaining
    // client-SDK read is users/{uid}, tenants/{id}, or
    // tenants/{id}/vouchers.
    //
    // Closed rather than deleted: an explicit deny documents that this is
    // intentional, and makes it harder to casually re-open. Server-side
    // Admin SDK access bypasses rules entirely, so if the old data ever
    // needs migrating, that still works.
    
    match /locations/{locationId} {
      allow read: if false;
      allow write: if false;
    }
    
    match /plans/{planId} {
      allow read: if false;
      allow write: if false;
    }
    
    match /vouchers/{voucherId} {
      allow read: if false;
      allow write: if false;
    }
    
    match /payments/{paymentId} {
      allow read: if false;
      allow write: if false;
    }
    
    // Platform config - public read so onboarding
    // page can fetch billing plan info client-side,
    // write is server-side only
    match /platform/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Email template config - server-side only, both ways. The superadmin
    // page reads it through the Admin SDK, never the client SDK.
    match /emailConfig/{document} {
      allow read: if false;
      allow write: if false;
    }

    // Billing plans - public read so onboarding can list
    // selectable plans, write is server-side only (superadmin APIs)
    match /billingPlans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // Addon catalog - a price list, same shape as billingPlans. Public read
    // is harmless and lets marketing surfaces render it; writes are the
    // superadmin API only. Note that reading this tells you what an addon
    // costs, never who has one - that lives in tenants/{id}/entitlements,
    // which is closed.
    match /addons/{addonKey} {
      allow read: if true;
      allow write: if false;
    }

    // Paystack subscription code -> what it pays for. Server-side only.
    // Readable, this would map a tenant to their subscription codes;
    // writable, it would let a tenant point an addon subscription at
    // somebody else's entitlement.
    match /subscriptionIndex/{subscriptionCode} {
      allow read: if false;
      allow write: if false;
    }

    // Redeemed addon payment references. Server-side only: the whole point
    // of these documents is that they are claimed exactly once by the
    // Admin SDK, so a client that could create or delete one could redeem
    // the same payment twice.
    match /addonPayments/{reference} {
      allow read: if false;
      allow write: if false;
    }

    // Charges the reconciliation job must not fulfil. Server-side only:
    // writable, a tenant could suppress recovery of their own customers'
    // unfulfilled payments.
    match /reconcileSkips/{reference} {
      allow read: if false;
      allow write: if false;
    }
  }
}
