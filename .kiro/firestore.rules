rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Locations — read by authenticated users, write by admin only (server-side)
    match /locations/{locationId} {
      allow read: if request.auth != null;
      allow write: if false; // server-side only
    }

    // Plans — read by authenticated users, write by admin only (server-side)
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false; // server-side only
    }

    // Vouchers — customers read their own, admin reads all (server-side)
    match /vouchers/{voucherId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // server-side only
    }

    // Payments — customers read their own, admin reads all (server-side)
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // server-side only
    }
  }
}
