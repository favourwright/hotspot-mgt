/**
 * Writes lib/generated/api-routes.ts: every documented route under
 * app/api/v1, with the path its file location gives it.
 *
 * This is what makes the API docs need no registry. A route's path is where
 * its file is (`app/api/v1/payments/[reference]/route.ts` is
 * `/payments/{reference}`), and everything else the docs say is in the
 * `publicApi({...})` declaration inside it. Nobody lists endpoints by hand,
 * so a new one cannot be forgotten.
 *
 * Runs on its own before `npm run dev` and `npm run build` (predev and
 * prebuild in package.json). `--check` exits 1 if the file is stale, for CI
 * and for `npm run check:api-index`.
 *
 * Only files that call `publicApi(` are included; anything else under
 * app/api/v1 (the OpenAPI document's own route) is not an endpoint.
 */
import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync } from "node:fs";
import { dirname, join, relative, sep } from "node:path";

const ROOT = process.cwd();
const API_DIR = join(ROOT, "app", "api", "v1");
const OUT = join(ROOT, "lib", "generated", "api-routes.ts");

function walk(dir: string, out: string[] = []): string[] {
  for (const name of readdirSync(dir).sort()) {
    const path = join(dir, name);
    if (statSync(path).isDirectory()) walk(path, out);
    else if (name === "route.ts") out.push(path);
  }
  return out;
}

const routes = walk(API_DIR)
  .filter((file) => readFileSync(file, "utf8").includes("publicApi("))
  .map((file) => {
    const dir = relative(API_DIR, dirname(file)).split(sep).join("/");
    const path = "/" + dir.replace(/\[([^\]]+)\]/g, "{$1}");
    const importPath = "@/" + relative(ROOT, file).split(sep).join("/").replace(/\.ts$/, "");
    return { path, importPath };
  });

const body = `// GENERATED by scripts/generate-api-index.mts from the files under
// app/api/v1. Do not edit: \`npm run dev\` and \`npm run build\` rewrite it.
// It lists every documented endpoint so lib/openapi.ts can describe them.

${routes.map((r, i) => `import * as route${i} from "${r.importPath}";`).join("\n")}

export const API_ROUTES = [
${routes.map((r, i) => `  { path: "${r.path}", module: route${i} },`).join("\n")}
] as const;
`;

const current = existsSync(OUT) ? readFileSync(OUT, "utf8") : "";
if (process.argv.includes("--check")) {
  if (current !== body) {
    console.log("lib/generated/api-routes.ts is out of date. Run: npm run generate:api-index");
    process.exit(1);
  }
  console.log(`API index up to date: ${routes.length} routes.`);
} else {
  mkdirSync(dirname(OUT), { recursive: true });
  if (current !== body) writeFileSync(OUT, body);
  console.log(`API index: ${routes.length} routes.`);
}
