# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Firebase (client) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the literal \n escapes if pasting a service-account private key inline.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Paystack ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- App ---
# The public URL this deployment is reachable at (no trailing slash).
# On the production VPS this currently includes a port: http://<vps-ip>:8080
# — port 80 there is already in use by other unrelated sites (see
# docs/deployment.md). Baked into the client bundle at build time, so
# this must be set correctly *before* running `npm run build`, not just at
# runtime.
NEXT_PUBLIC_APP_URL=

# --- Roles ---
SUPERADMIN_EMAIL=
# Legacy — still checked for backward compatibility, can match SUPERADMIN_EMAIL.
ADMIN_EMAIL=

# --- WireGuard manager (VPS-only; irrelevant for local dev unless tunneled) ---
WG_MANAGER_URL=
WG_MANAGER_SECRET=
