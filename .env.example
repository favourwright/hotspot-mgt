# The template for BOTH local env files. Copy it twice:
#
#   cp .env.example .env.development.local   # fill with LOCAL / TEST values
#   cp .env.example .env.production          # fill with LIVE values
#
# Same variable names in both, different values. Nothing is ever commented in
# or out: Next.js picks the file for you.
#
#   npm run dev     reads .env.development.local
#   npm run build   reads .env.production, and that build is what deploys
#
# Both are gitignored and local-only. The VPS has neither - it keeps its own
# .env.local for the server-side secrets `next start` reads at runtime, and
# NEXT_PUBLIC_* values reach it already compiled into .next/. Push a live
# server-side value to it with `npm run env:push -- <NAME>`.
#
# Do NOT create a .env.local here. Lookup order, highest priority first:
#
#   process.env > .env.$NODE_ENV.local > .env.local > .env.$NODE_ENV > .env
#
# .env.local sits above .env.production and is loaded in every environment,
# so test values in it would be silently baked into the production build -
# which is the whole failure this split exists to prevent. `npm run env:check`
# fails if one appears, and also if the two files drift out of step.

# --- Firebase (client) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the literal \n escapes if pasting a service-account private key inline.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Paystack ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- App ---
# The public URL this deployment is reachable at (no trailing slash).
# In production this is https://ogawifi.online. It is the single source of
# truth for the root domain: subdomain routing (proxy.ts), the session
# cookie's Domain (lib/server-auth.ts), tenant link generation
# (lib/tenant-url.ts) and the routers' walled garden (lib/hotspot-portal.ts)
# all derive from it. An IP or localhost here means "no subdomains", and the
# app falls back to path-based tenant routing.
# Baked into the client bundle at build time, so this must be set correctly
# *before* running `npm run build`, not just at runtime.
#
#   .env.development.local  ->  http://localhost:3000
#   .env.production         ->  https://ogawifi.online
#
# Getting this one crossed is not subtle in its effects but is very subtle in
# its symptoms: the production value under localhost sends a session cookie
# with Domain=ogawifi.online, the browser rejects it, and every sign-in
# bounces straight back to /auth with no server-side error anywhere.
NEXT_PUBLIC_APP_URL=

# --- Roles ---
SUPERADMIN_EMAIL=
# Legacy - still checked for backward compatibility, can match SUPERADMIN_EMAIL.
ADMIN_EMAIL=

# --- Email (Mailtrap) ---
# Mailtrap's production Sending API, not the testing sandbox. Without both of
# the first two set, every email is skipped with a log line and nothing else
# breaks - see docs/emails.md.
#
# API token: Mailtrap > Sending Domains > API Tokens (needs send permission).
MAILTRAP_API_TOKEN=
# Must be an address on a domain verified in Mailtrap, or sends are rejected.
MAILTRAP_SENDER_EMAIL=
MAILTRAP_SENDER_NAME=OgaWiFi
# Fallback only. Alert recipients and the user-facing support address are now
# configured at /superadmin/emails and stored in Firestore, so they change
# without a deploy. This is used when that has never been set, so a fresh
# deployment still alerts somebody. Falls back further to SUPERADMIN_EMAIL.
PLATFORM_ALERT_EMAIL=

# --- Scheduled jobs ---
# Shared secret for /api/cron/<job>, which systemd's timers call on loopback.
# nginx proxies that path to the app like any other, so this secret is the
# only thing protecting it. Unset means the endpoint refuses every request,
# which is the safe default. Generate with: openssl rand -hex 32
# Put it on the VPS with: npm run env:push -- CRON_SECRET
CRON_SECRET=

# --- Decision hooks ---
# Encrypts tenants' hook signing secrets at rest (lib/hook-secrets.ts). 32
# random bytes, base64. Unset means hooks cannot be created and existing ones
# fail to their owner's chosen strategy, so set it before anyone creates one.
# Never change it once hooks exist: every stored secret would become
# unreadable. Generate with: openssl rand -base64 32
# Put it on the VPS with: npm run env:push -- HOOK_SECRETS_KEY
HOOK_SECRETS_KEY=

# Encrypts router passwords at rest (lib/router-credentials.ts). Optional until set:
# without it they stay in plaintext as before. Once anything is encrypted, losing or
# changing it stops every encrypted router until its owner retypes the password, so
# keep a copy off the VPS. Dev and production share a Firebase project, so both env
# files need the SAME value. Generate with: openssl rand -base64 32
# Put it on the VPS with: npm run env:push -- ROUTER_SECRETS_KEY
ROUTER_SECRETS_KEY=

# --- WireGuard manager (VPS-only; irrelevant for local dev unless tunneled) ---
WG_MANAGER_URL=
WG_MANAGER_SECRET=

# --- TLS certificate renewal (VPS-only; NOT read by the app) ---
# A Cloudflare API token scoped to Zone:DNS:Edit + Zone:Zone:Read on this
# project's zone only. certbot uses it to answer the DNS-01 challenge that
# issues and renews the wildcard certificate; nothing in the application
# code ever reads it.
#
# It lives on the VPS at /root/.secrets/cloudflare.ini. Set it here and run
# `npm run cloudflare:token` to push it there and verify renewal works.
# See docs/domain-and-tls.md.
CLOUDFLARE_API_TOKEN=
